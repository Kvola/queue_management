<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_queue_ticket_list" model="ir.ui.view">
        <field name="name">queue.ticket.list</field>
        <field name="model">queue.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-muted="state in ('done','no_show','cancelled')"
                  decoration-bf="state == 'called'">
                <field name="name"/>
                <field name="service_id"/>
                <field name="position"/>
                <field name="priority" widget="badge"
                       decoration-warning="priority == '1'"
                       decoration-danger="priority == '2'"/>
                <field name="channel"/>
                <field name="partner_id" optional="show"/>
                <field name="counter_id"/>
                <field name="scheduled_time" optional="hide"/>
                <field name="created_at"/>
                <field name="payment_state" widget="badge" optional="show"
                       decoration-warning="payment_state == 'pending'"
                       decoration-info="payment_state == 'to_validate'"
                       decoration-success="payment_state == 'paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'waiting'"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('no_show','cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_queue_ticket_form" model="ir.ui.view">
        <field name="name">queue.ticket.form</field>
        <field name="model">queue.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_check_in" type="object" string="Enregistrer (arrivée)"
                            class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_start" type="object" string="Démarrer"
                            class="btn-primary" invisible="state != 'called'"/>
                    <button name="action_done" type="object" string="Terminer"
                            class="btn-success" invisible="state not in ('called','serving')"/>
                    <button name="action_recall" type="object" string="Rappeler"
                            invisible="state != 'called'"/>
                    <button name="action_no_show" type="object" string="Absent"
                            invisible="state != 'called'"/>
                    <button name="%(action_queue_ticket_transfer)d" type="action"
                            string="Transférer"
                            invisible="state not in ('waiting', 'called')"
                            help="Réoriente le client vers une autre file du site, sans lui faire refaire la queue."/>
                    <button name="action_requeue" type="object"
                            string="Re-mettre en file" class="btn-primary"
                            invisible="state != 'no_show'"
                            help="Le client s'est présenté après avoir été marqué absent : il reprend sa place selon son heure d'arrivée d'origine."/>
                    <button name="action_validate_payment" type="object"
                            string="Valider le paiement" class="btn-primary"
                            invisible="payment_state != 'to_validate'"
                            help="Confirme le paiement déclaré par le client."/>
                    <button name="action_reject_payment" type="object"
                            string="Rejeter le paiement"
                            invisible="payment_state != 'to_validate'"
                            confirm="Rejeter ce paiement ? Le client devra régler à nouveau."/>
                    <button name="action_register_payment" type="object"
                            string="Encaisser" class="btn-primary"
                            invisible="payment_state != 'pending'"
                            help="Encaissement direct au guichet (le paiement passe payé)."/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('done','no_show','cancelled')"
                            confirm="Annuler ce ticket ?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,waiting,called,serving,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Annulé" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Absent" bg_color="text-bg-warning"
                            invisible="state != 'no_show'"/>
                    <widget name="web_ribbon" title="Terminé" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="À payer" bg_color="text-bg-warning"
                            invisible="payment_state != 'pending'"/>
                    <widget name="web_ribbon" title="Paiement à valider" bg_color="text-bg-info"
                            invisible="payment_state != 'to_validate'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="me-2"/>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Client &amp; canal">
                            <field name="partner_id"
                                   placeholder="Vide = ticket anonyme (borne)"/>
                            <field name="channel"/>
                            <field name="scheduled_time"
                                   invisible="channel != 'appointment'"
                                   required="channel == 'appointment'"/>
                        </group>
                        <group string="Paiement" invisible="payment_state == 'not_required'">
                            <field name="payment_state"/>
                            <field name="payment_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method"
                                   invisible="payment_state in ('pending',)"/>
                            <field name="payment_ref"
                                   invisible="not payment_ref"/>
                            <field name="payment_submitted_at"
                                   invisible="payment_state != 'to_validate'"/>
                            <field name="payment_proof" filename="payment_proof_filename"
                                   invisible="not payment_proof"/>
                            <field name="payment_proof_filename" invisible="1"/>
                            <field name="paid_at" invisible="payment_state != 'paid'"/>
                            <field name="payment_validated_by"
                                   invisible="payment_state != 'paid'"/>
                        </group>
                        <group string="Service &amp; guichet">
                            <field name="service_id"
                                   readonly="state not in ('scheduled', 'waiting')"/>
                            <field name="location_id"/>
                            <field name="counter_id" readonly="1"/>
                            <field name="position" invisible="state != 'waiting'"/>
                            <field name="eta_minutes" invisible="state != 'waiting'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Horodatages &amp; durées" name="times">
                            <group>
                                <group string="Horodatages">
                                    <field name="created_at" readonly="1"/>
                                    <field name="called_at" readonly="1"/>
                                    <field name="served_at" readonly="1"/>
                                    <field name="closed_at" readonly="1"/>
                                </group>
                                <group string="Durées réelles">
                                    <field name="wait_real_minutes"/>
                                    <field name="service_real_minutes"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_queue_ticket_search" model="ir.ui.view">
        <field name="name">queue.ticket.search</field>
        <field name="model">queue.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="service_id"/>
                <field name="partner_id"/>
                <filter name="waiting" string="En attente" domain="[('state','=','waiting')]"/>
                <filter name="active" string="Actifs"
                        domain="[('state','in',('waiting','called','serving'))]"/>
                <filter name="to_pay" string="À payer"
                        domain="[('payment_state','=','pending')]"/>
                <filter name="to_validate" string="Paiements à valider"
                        domain="[('payment_state','=','to_validate')]"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('created_at','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_service" string="Service" context="{'group_by':'service_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by':'state'}"/>
                    <filter name="group_channel" string="Canal" context="{'group_by':'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_queue_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">queue.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_queue_ticket_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_queue_payments_to_validate" model="ir.actions.act_window">
        <field name="name">Paiements à valider</field>
        <field name="res_model">queue.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_state','=','to_validate')]</field>
        <field name="context">{'search_default_to_validate': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun paiement en attente de validation</p>
            <p>Les paiements déclarés par les clients (Wave marchand, au guichet,
               preuve) apparaissent ici pour être validés au guichet.</p>
        </field>
    </record>

</odoo>
