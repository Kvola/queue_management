<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Les versions de Kvla File vivent dans le catalogue commun
         (`mobile_app_release`) : une page `/apps/kvla-file`, un historique, une
         empreinte, un compteur — le même circuit que les autres applications.
         Ce menu n'en est que la porte depuis la file d'attente. -->
    <record id="action_queue_app_releases" model="ir.actions.act_window">
        <field name="name">Versions de Kvla File</field>
        <field name="res_model">mobile.app.release</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('app_id.slug', '=', 'kvla-file')]</field>
        <!-- `eval` et NON un texte : le `context` d'une action est évalué par
             le NAVIGATEUR, qui ne connaît pas `ref()`. -->
        <field name="context" eval="{'default_app_id': ref('queue_management.mobile_app_kvla_file')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Publier une version de Kvla File</p>
            <p>
                Téléversez l'APK construit par <code>build_prod_apk.sh</code>,
                puis publiez-le : il est servi sur <code>/apps/kvla-file</code>,
                que désignent les QR de la borne et de l'écran de salle.
            </p>
        </field>
    </record>

    <menuitem id="menu_queue_app_release" name="App mobile"
              parent="menu_queue_config" action="action_queue_app_releases"
              sequence="80" groups="base.group_system"/>

</odoo>
