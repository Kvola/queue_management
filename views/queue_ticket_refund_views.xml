<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_queue_ticket_refund_wizard_form" model="ir.ui.view">
        <field name="name">queue.ticket.refund.wizard.form</field>
        <field name="model">queue.ticket.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Rembourser">
                <div class="alert alert-info" role="alert">
                    Rien n'est viré automatiquement : rendez l'argent (espèces,
                    envoi Wave), puis enregistrez-le ici pour en garder la trace.
                </div>
                <group>
                    <field name="ticket_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="refundable" widget="monetary"/>
                    <field name="amount" widget="monetary"/>
                    <field name="method"/>
                    <field name="reason" placeholder="Service non rendu, ticket annulé…"/>
                </group>
                <footer>
                    <button name="action_refund" type="object" string="Enregistrer le remboursement"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
