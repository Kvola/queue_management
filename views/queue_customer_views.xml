<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_queue_customer_list" model="ir.ui.view">
        <field name="name">queue.customer.list</field>
        <field name="model">queue.customer</field>
        <field name="arch" type="xml">
            <list string="Clients mobiles">
                <field name="name"/>
                <field name="email"/>
                <field name="partner_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_queue_customer_form" model="ir.ui.view">
        <field name="name">queue.customer.form</field>
        <field name="model">queue.customer</field>
        <field name="arch" type="xml">
            <form string="Client mobile">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object"
                                class="oe_stat_button" icon="fa-ticket"
                                invisible="not partner_id">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="email"/>
                        <h1><field name="email" placeholder="client@exemple.com"/></h1>
                    </div>
                    <group>
                        <group string="Identité">
                            <field name="name" placeholder="Nom affiché (optionnel)"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Connexion">
                            <field name="create_date" string="Inscrit le" readonly="1"/>
                            <field name="last_otp_sent" readonly="1"/>
                            <field name="token_expiry" groups="base.group_system"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Les clients s'inscrivent eux-mêmes depuis l'application
                        (connexion par code email). Archiver un client bloque
                        immédiatement sa session mobile.
                    </p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_queue_customer" model="ir.actions.act_window">
        <field name="name">Clients mobiles</field>
        <field name="res_model">queue.customer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun client mobile pour le moment</p>
            <p>Les clients apparaissent ici dès qu'ils prennent un ticket chez
               vous depuis l'application. Vous ne voyez que les clients ayant
               un ticket dans vos établissements.</p>
        </field>
    </record>

    <menuitem id="menu_queue_customers" name="Clients mobiles"
              parent="menu_queue_config" action="action_queue_customer"
              sequence="30"/>

</odoo>
