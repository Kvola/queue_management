<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_queue_app_release_list" model="ir.ui.view">
        <field name="name">queue.app.release.list</field>
        <field name="model">queue.app.release</field>
        <field name="arch" type="xml">
            <list string="Versions de l'app" decoration-success="is_active">
                <field name="name"/>
                <field name="released_date"/>
                <field name="apk_size_mb"/>
                <field name="download_count"/>
                <field name="is_active" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_queue_app_release_form" model="ir.ui.view">
        <field name="name">queue.app.release.form</field>
        <field name="model">queue.app.release</field>
        <field name="arch" type="xml">
            <form string="Version de l'app">
                <header>
                    <button name="action_publish" type="object" string="Publier"
                            class="btn-primary" invisible="is_active"/>
                    <button name="action_unpublish" type="object" string="Dépublier"
                            invisible="not is_active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Publiée"
                            invisible="not is_active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="version" placeholder="1.0.0"/>
                            <field name="build_number"/>
                            <field name="released_date"/>
                            <field name="apk_file" filename="apk_file_name"/>
                            <field name="apk_file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="apk_size_mb"/>
                            <field name="download_count"/>
                            <field name="apk_sha256"/>
                            <field name="landing_url" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes de version">
                            <field name="release_notes"
                                   placeholder="Nouveautés de cette version…"/>
                        </page>
                        <page string="QR code (à imprimer)">
                            <p class="text-muted">
                                Ce QR pointe vers la page d'installation publique
                                (<code>/queue/app</code>). Il est aussi affiché
                                automatiquement sur la borne et l'écran de salle
                                d'attente dès qu'une version est publiée. Si le
                                paramètre système
                                <code>queue_management.app_store_url</code> est
                                défini, la page redirige vers le store — les QR
                                imprimés restent valables.
                            </p>
                            <field name="qr_html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_queue_app_release" model="ir.actions.act_window">
        <field name="name">Versions de l'app mobile</field>
        <field name="res_model">queue.app.release</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Téléversez la première version de l'app</p>
            <p>Publiez un APK : il devient téléchargeable sur la page publique
               <code>/queue/app</code> et un QR d'installation apparaît sur la
               borne et l'écran de salle d'attente.</p>
        </field>
    </record>

    <menuitem id="menu_queue_app_release" name="App mobile"
              parent="menu_queue_config" action="action_queue_app_release"
              sequence="40"/>

</odoo>
