<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_queue_location_list" model="ir.ui.view">
        <field name="name">queue.location.list</field>
        <field name="model">queue.location</field>
        <field name="arch" type="xml">
            <list string="Sites">
                <field name="name"/>
                <field name="city"/>
                <field name="service_count"/>
                <field name="counter_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_queue_location_form" model="ir.ui.view">
        <field name="name">queue.location.form</field>
        <field name="model">queue.location</field>
        <field name="arch" type="xml">
            <form string="Site">
                <header>
                    <button name="action_open_display" type="object"
                            string="Écran d'affichage" class="btn-primary"/>
                    <button name="action_open_kiosk" type="object"
                            string="Borne tactile" class="btn-secondary"/>
                    <button name="action_regenerate_qr_token" type="object"
                            string="Régénérer le QR" class="btn-secondary"
                            confirm="L'ancien QR code affiché à l'entrée ne fonctionnera plus. Continuer ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. Hôpital Central — Site principal"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="qr_token"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Files">
                            <field name="service_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="waiting_count"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Guichets">
                            <field name="counter_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="service_ids" widget="many2many_tags"/>
                                    <field name="agent_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_queue_location" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">queue.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
